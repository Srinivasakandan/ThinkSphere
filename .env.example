# Supabase (leave blank to run in demo/mock mode with no backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the FastAPI backend (e.g. http://localhost:8000). Leave
# blank to run entirely on the built-in mock data layer — see
# docs/API_CONTRACT.md §1. When set, lib/api/*.ts calls the real backend
# and falls back to Supabase-only auth if it's unreachable.
NEXT_PUBLIC_API_BASE_URL=
