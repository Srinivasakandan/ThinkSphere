# Supabase (leave blank to run in demo/mock mode with no backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the FastAPI backend (e.g. http://localhost:8000). Leave
# blank to run entirely on the built-in mock data layer (static,
# canned demo data) — see docs/API_CONTRACT.md §1. Set this to run
# against the real backend instead: real OCR/extraction on whatever you
# upload or scan, not pre-scripted responses. See backend/.env.example
# for OCR_PROVIDER, which controls whether that backend itself reads the
# real image (Tesseract) or also just returns mock text.
NEXT_PUBLIC_API_BASE_URL=
