# PostgreSQL connection string (SQLAlchemy + psycopg3 driver)
DATABASE_URL=postgresql+psycopg://thinksphere:thinksphere@localhost:5432/thinksphere

# CORS: the Next.js frontend origin
FRONTEND_URL=http://localhost:3000

# Supabase Auth / Storage — leave blank to run in mock mode (no backend
# services required; requests are treated as a fixed demo inspector).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=inspection-images

# OCR engine selection:
#   auto      (default) real Tesseract OCR when the tesseract-ocr binary
#             is installed. When it isn't, reports "no text detected"
#             for every image (routes everything to manual review) —
#             NEVER fabricates plausible label content, so a missing
#             install is never mistaken for a working pipeline.
#   tesseract force real OCR (fails loudly if the binary is missing).
#   mock      explicitly opt into deterministic demo/mock text for
#             exercising the UI without installing Tesseract — never
#             reads the actual uploaded image. Only for disclosed,
#             deliberate local development/demo use, never the default.
# Install the engine with `apt-get install tesseract-ocr` (Debian/Ubuntu)
# or the equivalent for your OS; opencv-python-headless (requirements.txt)
# preprocesses images before OCR — no extra install needed for that part.
OCR_PROVIDER=auto

# Local filesystem fallback used for image/report storage when Supabase
# Storage is not configured.
LOCAL_STORAGE_DIR=./storage_mock

# This API's own publicly-reachable base URL, e.g. http://localhost:8000
# in local dev or https://api.example.com in production. REQUIRED
# whenever the frontend (NEXT_PUBLIC_API_BASE_URL) runs on a different
# origin than this API and Supabase Storage isn't configured — otherwise
# uploaded image/report URLs come back as a bare "/media/..." path that
# resolves against the frontend's origin in the browser and 404s.
BACKEND_PUBLIC_URL=http://localhost:8000

# development | production
API_ENV=development

# Whether unauthenticated requests fall back to a fixed demo inspector.
# Only meaningful when Supabase is not configured; never enable in
# production.
ALLOW_MOCK_AUTH=true

# Image upload limits (spec: file upload contract).
MAX_IMAGE_SIZE_MB=10
MAX_IMAGES_PER_INSPECTION=10
